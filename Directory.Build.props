<Project>

  <PropertyGroup>
    <!--
      Settings every project inherits. Per-project files override where they must; nothing
      here assumes Windows, because Core and its tests are expected to build and run on
      macOS and Linux in CI.
    -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Deliberately NOT setting InvariantGlobalization. ICU is load-bearing here: IANA time
      zone ids on Windows and localized month and day names both come from it, and layout
      is computed from an explicit CultureInfo.
    -->

    <!-- Lets the Linux and macOS CI legs compile the net10.0-windows print shim against the
         downloadable WindowsDesktop reference pack instead of skipping it. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.3.0</Version>
    <Product>Printendar</Product>
    <Authors>levinium</Authors>
    <Copyright>Copyright (c) Printendar contributors</Copyright>
    <RepositoryUrl>https://github.com/levinium/Printendar</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
