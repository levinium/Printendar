<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Two frameworks so Windows can drive a printer directly while the app stays genuinely
      cross-platform. The -windows build picks up Printendar.Printing.Windows and its real
      print dialog; the plain build falls back to handing the PDF to the operating system.

      The split is compile-time, through a conditional ProjectReference and the WINDOWS symbol
      the SDK defines for the -windows framework. No reflection and no plugin loading, so a
      mistake here is a build error rather than a missing button at runtime.
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>Printendar.App</RootNamespace>
    <AssemblyName>Printendar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>

    <!-- Avalonia compiles XAML at build time and reports binding errors as build errors. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <!--
      Referenced explicitly, not just transitively. The preview control leases the SKCanvas
      from Avalonia's Skia renderer so that Printendar's own SceneRenderer draws onto it, and
      ISkiaSharpApiLeaseFeature lives in this assembly.
    -->
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Printendar.Core\Printendar.Core.csproj" />
    <ProjectReference Include="..\Printendar.Sources.Microsoft365\Printendar.Sources.Microsoft365.csproj" />
    <ProjectReference Include="..\Printendar.Sources.Ics\Printendar.Sources.Ics.csproj" />
  </ItemGroup>

  <!-- Only the Windows build gets the printing shim. Everything else must not see it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\Printendar.Printing.Windows\Printendar.Printing.Windows.csproj" />
  </ItemGroup>

</Project>
