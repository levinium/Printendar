<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Printendar.App.Controls"
        xmlns:vm="clr-namespace:Printendar.App"
        xmlns:src="clr-namespace:Printendar.App.Sources"
        xmlns:paper="clr-namespace:Printendar.Core.Paper;assembly=Printendar.Core"
        x:Class="Printendar.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Printendar"
        Icon="/Assets/printendar.ico"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="600">

  <Window.Resources>
    <!--
      Drawn rather than typed. The pencil, the arrows and the bin exist as characters, but
      those come from whatever font the system decides to substitute, which means three icons
      at three weights and, on some machines, a colour emoji bin among two monochrome glyphs.
      Geometry is the same everywhere and inherits the theme's foreground like everything else.
    -->
    <StreamGeometry x:Key="IconPencil">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>
    <StreamGeometry x:Key="IconRefresh">M12 6V3L8 7l4 4V8c2.76 0 5 2.24 5 5 0 .84-.21 1.63-.58 2.32l1.46 1.46A6.94 6.94 0 0 0 19 13c0-3.87-3.13-7-7-7zm0 12c-2.76 0-5-2.24-5-5 0-.84.21-1.63.58-2.32L6.12 9.22A6.94 6.94 0 0 0 5 13c0 3.87 3.13 7 7 7v3l4-4-4-4v3z</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
    <StreamGeometry x:Key="IconGear">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84a.48.48 0 0 0-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.48.48 0 0 0-.59.22L2.74 8.87a.49.49 0 0 0 .12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 0 1 8.4 12 3.6 3.6 0 0 1 12 8.4a3.6 3.6 0 0 1 3.6 3.6 3.6 3.6 0 0 1-3.6 3.6z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <!--
      Quiet until wanted. Three buttons on every card would otherwise out-shout the calendar
      names they belong to, and the list is read on every print while these are pressed once
      in a while.
    -->
    <Style Selector="Button.rowaction">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.rowaction:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Removing is the one action here that cannot be undone, so it is the one that changes
         colour rather than just brightening. -->
    <Style Selector="Button.rowaction.danger:pointerover Path.rowicon">
      <Setter Property="Fill" Value="#C42B2B" />
    </Style>

    <Style Selector="Path.rowicon">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.sectionHeading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,4" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBox, NumericUpDown">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- Explains the consequence of the option above it. Collapses when there is nothing
         to say, so the panel does not carry empty gaps. -->
    <Style Selector="TextBlock.hint">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.hint:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- The colour square beside a calendar. Sized and padded down to look like the swatch it
         replaced rather than like a button, since it sits inside a list of names. -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.colorchoice">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- The everyday controls sit on the top bar. Everything a person needs to print this
         month and no more: pick a month, print it. The rest is refinement in the panel. -->
    <Border DockPanel.Dock="Top" Padding="12,10" Background="{DynamicResource PanelBackground}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
        <Button Grid.Column="0" Name="PreviousMonth" Content="&#x2039;" Width="36" ToolTip.Tip="Previous month" />
        <Button Grid.Column="1" Name="NextMonth" Content="&#x203A;" Width="36" Margin="4,0,0,0" ToolTip.Tip="Next month" />
        <TextBlock Grid.Column="2"
                   Text="{Binding MonthTitle}"
                   FontSize="20" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Grid.Column="4" Name="SavePdf" Content="Save as PDF" Margin="0,0,8,0" />
        <Button Grid.Column="5" Name="Print" Content="Print" Classes="accent" />

        <!-- Which build this is, where somebody can read it out without going looking. Small
             and quiet: it is worth nothing until the moment somebody is filing a bug, and
             then it is the first thing anybody asks for. -->
        <TextBlock Grid.Column="6" Name="VersionLabel"
                   VerticalAlignment="Center" Margin="16,0,0,0"
                   FontSize="11" Opacity="0.5" />

        <Button Grid.Column="7" Name="OpenSettings" Classes="rowaction"
                Margin="8,0,0,0" ToolTip.Tip="Settings">
          <Path Data="{StaticResource IconGear}" Classes="rowicon" />
        </Button>
      </Grid>
    </Border>

    <!-- What the layout had to do to make it fit, in words, with the lever to pull. -->
    <Border DockPanel.Dock="Bottom" Padding="12,8" Background="{DynamicResource PanelBackground}">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.85" />
    </Border>

    <ScrollViewer DockPanel.Dock="Right" Width="280" Padding="12,0,12,12">
      <StackPanel>

        <TextBlock Classes="sectionHeading" Text="CALENDARS" />

        <!-- A page missing an account''s events still draws perfectly, so nothing about it
             reveals the problem. This has to be loud, and it stays until it is resolved. -->
        <Border IsVisible="{Binding Sources.HasMissingData}"
                Background="#5c1a1a" BorderBrush="#a33" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="⚠ This page is incomplete"
                       FontWeight="SemiBold" Foreground="#ffd7d7" />
            <TextBlock Text="{Binding Sources.MissingDataWarning}"
                       TextWrapping="Wrap" FontSize="11" Foreground="#ffd7d7"
                       Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- A list of things, not a row of verbs. Everything that adds, signs into or removes
             a calendar lives behind one button, because those are occasional actions and this
             panel is read every time. -->
        <ItemsControl ItemsSource="{Binding Sources.Sources}">
          <ItemsControl.ItemTemplate>
            <!-- One row per calendar, not a source with a list nested under it. Every source
                 Printendar can read is a single iCalendar, so the nested list only ever held
                 one item, and it carried the same name as the heading above it: every calendar
                 was drawn twice, once as a title and once as its own only child. -->
            <DataTemplate x:DataType="src:SourceEntry">

              <!-- A card each, matching the manage window's list so the two read as the same
                   set of things. Spacing alone stopped being enough once a row could carry a
                   name, a kind and a wrapped error: three lines of one calendar and one line
                   of the next ran together, and the error looked like it belonged to whichever
                   name your eye landed on. -->
              <Border Margin="0,0,0,6" Padding="9,8" CornerRadius="4"
                      Background="{DynamicResource CardBackground}"
                      BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
              <StackPanel>

                <!-- Two columns, not one row of controls. The tick and the swatch do unrelated
                     jobs, and side by side a click aimed at one landed on the other often
                     enough to matter: whether a calendar prints at all, and what colour it
                     prints in, should not be a pixel apart. The names now line up hard left
                     and the colours hard right, so the list also reads as a legend. -->
                <Grid ColumnDefinitions="*,Auto">

                  <!-- The swatch shows the printed colour, so it is the obvious thing to click
                       to change it: no new screen, and it is in front of you at the moment two
                       calendars look alike. Hidden until the calendar has been read, because
                       until then there is no colour to show and nothing to change. -->
                  <Button Grid.Column="1" Classes="swatch" Background="{Binding Calendar.Swatch}"
                          IsVisible="{Binding HasCalendar}"
                          Margin="8,0,0,0" VerticalAlignment="Center"
                          ToolTip.Tip="Change the colour this calendar prints in">
                    <Button.Flyout>
                      <Flyout Placement="Bottom">
                        <StackPanel Spacing="8">
                          <TextBlock Text="PRINTS IN" FontWeight="SemiBold" FontSize="11"
                                     Opacity="0.75" />
                          <ItemsControl ItemsSource="{Binding Calendar.Choices}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="152" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CalendarColorChoice">
                                <Button Classes="colorchoice"
                                        Background="{Binding Swatch}"
                                        Command="{Binding Choose}">
                                  <TextBlock Text="✓" IsVisible="{Binding IsCurrent}"
                                             Foreground="White" FontWeight="Bold"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Content="Custom…" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  Click="OnCustomColor" />
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>

                  <!-- The name sits inside the tick so that clicking either one works, which
                       is what people expect of a list of things to include. The plain version
                       below is for a calendar that has not been read yet, or could not be:
                       there is nothing to tick, but it still has to be identifiable. -->
                  <CheckBox Grid.Column="0" IsChecked="{Binding Calendar.IsSelected}"
                            IsVisible="{Binding HasCalendar}"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                               IsVisible="{Binding IsNotEditingName}"
                               TextTrimming="CharacterEllipsis" />
                  </CheckBox>

                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold"
                             IsVisible="{Binding HasNoCalendar}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Two controls rather than one box styled to look like both. Off, the name
                     is plainly text; on, it is an ordinary text field with the border the
                     theme gives every other one, so which state you are in is never in doubt.
                     It sits outside the tick because a text box inside a checkbox swallows
                     the space bar. -->
                <TextBox Name="NameBox" Text="{Binding EditableName}"
                         IsVisible="{Binding IsEditingName}"
                         FontWeight="SemiBold" Margin="0,2,0,0"
                         KeyDown="OnNameKeyDown" />

                <!-- The kind and the buttons share a line. The kind says whether this calendar
                     keeps itself up to date: a link is re-read before every print, a file is
                     whatever was exported. -->
                <Grid ColumnDefinitions="*,Auto" Margin="28,2,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding KindLabel}" FontSize="10"
                             Opacity="0.55" VerticalAlignment="Center" />

                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1">
                    <Button Name="RenameButton" Classes="rowaction" Click="OnToggleRename"
                            ToolTip.Tip="Rename this calendar">
                      <Path Data="{StaticResource IconPencil}" Classes="rowicon" />
                    </Button>
                    <Button Classes="rowaction" Click="OnRefreshOne"
                            ToolTip.Tip="Read this calendar again now">
                      <Path Data="{StaticResource IconRefresh}" Classes="rowicon" />
                    </Button>
                    <Button Classes="rowaction danger" Click="OnRemoveOne"
                            ToolTip.Tip="Remove this calendar">
                      <Path Data="{StaticResource IconTrash}" Classes="rowicon" />
                    </Button>
                  </StackPanel>
                </Grid>

                <!-- Against the calendar rather than in the status bar: with four of them
                     added, "could not be read" does not say which one to go and fix. -->
                <TextBlock Text="{Binding Error}"
                           IsVisible="{Binding HasError}"
                           FontSize="10" Foreground="#a30000"
                           TextWrapping="Wrap" Margin="28,2,0,0" />
              </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="hint"
                   IsVisible="{Binding HasNoSources}"
                   Text="Showing a sample month. Add a calendar to print your own. Printendar only ever reads your calendars." />

        <!-- A flyout rather than two buttons or a second window. There are exactly two ways a
             calendar gets in, and which one you want is a question with two answers, not a
             screen. Everything a calendar needs afterwards now lives on its own card. -->
        <Button Name="AddCalendar"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconPlus}" Classes="rowicon" />
            <TextBlock Text="Add calendar" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <StackPanel Spacing="4" MinWidth="250">
                <Button Name="AddLink" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="10,8">
                  <StackPanel Spacing="1">
                    <TextBlock Text="Calendar link" FontWeight="SemiBold" />
                    <TextBlock Text="Re-read before every print" FontSize="11" Opacity="0.65" />
                  </StackPanel>
                </Button>
                <Button Name="AddFile" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="10,8">
                  <StackPanel Spacing="1">
                    <TextBlock Text="Calendar file (.ics)" FontWeight="SemiBold" />
                    <TextBlock Text="A snapshot, until you export again" FontSize="11" Opacity="0.65" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBlock Name="CalendarMessage" Classes="hint" IsVisible="False" />
        <TextBlock Classes="sectionHeading" Text="PAPER" />
        <ComboBox ItemsSource="{Binding PaperSizeChoices}" SelectedItem="{Binding Paper}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="paper:PaperSize">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox ItemsSource="{Binding OrientationChoices}" SelectedItem="{Binding SelectedOrientation}" />

        <TextBlock Classes="sectionHeading" Text="MARGIN (INCHES)" />
        <NumericUpDown Value="{Binding MarginInches}" Minimum="0.1" Maximum="2" Increment="0.05"
                       FormatString="0.00" />

        <TextBlock Classes="sectionHeading" Text="WEEK" />
        <ComboBox ItemsSource="{Binding WeekStartChoices}" SelectedItem="{Binding SelectedWeekStart}" />
        <ComboBox ItemsSource="{Binding WeekendModeChoices}" SelectedItem="{Binding SelectedWeekendMode}" />
        <TextBlock Text="{Binding WeekendModeDescription}" Classes="hint" />
        <TextBlock Text="Squeezing the weekend needs weeks to start on Monday."
                   IsVisible="{Binding !CanCompressWeekend}"
                   Classes="hint" />

        <TextBlock Classes="sectionHeading" Text="WHEN A DAY IS TOO FULL TO FIT" />
        <ComboBox ItemsSource="{Binding FitPolicyChoices}" SelectedItem="{Binding SelectedFitPolicy}" />
        <TextBlock Text="{Binding FitPolicyDescription}" Classes="hint" />

        <TextBlock Classes="sectionHeading" Text="DETAIL" />
        <CheckBox Content="Show start times" IsChecked="{Binding ShowStartTimes}" />

        <TextBlock Classes="sectionHeading" Text="DAYS FROM THE MONTHS EITHER SIDE" />
        <ComboBox ItemsSource="{Binding AdjacentDayChoices}" SelectedItem="{Binding SelectedAdjacentDays}" />
      </StackPanel>
    </ScrollViewer>

    <Border Background="{DynamicResource PanelBackground}" Padding="20">
      <!-- Stretch, not Center. The preview fills the slot it is given and fits the sheet
           inside it; a size-negotiating preview pushed the options panel off the window. -->
      <controls:ScenePreview Name="Preview"
                             Scene="{Binding Scene}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch" />
    </Border>

  </DockPanel>
</Window>
