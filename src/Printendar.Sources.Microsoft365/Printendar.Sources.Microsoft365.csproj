<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Printendar.Sources.Microsoft365</RootNamespace>
    <Description>Reads calendars from Microsoft 365 and Outlook.com through Microsoft Graph.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      MSAL handles sign-in and the token cache. Graph itself is called over plain HTTP with
      System.Text.Json: Printendar needs two endpoints, and the Graph SDK is a large
      dependency to put into something people download. Hand-rolling OAuth would be the wrong
      trade in the other direction, which is why that stays MSAL.
    -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Printendar.Core\Printendar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Printendar.Core.Tests" />
  </ItemGroup>

</Project>
